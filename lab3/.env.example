# Copy to .env and fill in. .env is git-ignored: never commit real tokens.

# LLM: OpenAI-compatible endpoint (ITMO network only)
LLM_BASE_URL=http://10.32.2.11:35000/v1
LLM_API_KEY=<your personal token>
LLM_MODEL=qwen3.8-27b
LLM_TEMPERATURE=0.2
# false = chat_template_kwargs.enable_thinking=false (Qwen3 on vLLM): the response reserve is not eaten by reasoning
LLM_ENABLE_THINKING=false
# Fallback only if the server does not report max_model_len in GET /v1/models
LLM_CONTEXT_WINDOW=
# auto = vLLM POST /tokenize (exact, incl. chat template and tool schemas), else calibrated heuristic
TOKEN_COUNT_MODE=auto
CHARS_PER_TOKEN=2.6

# Task root (current working directory of tasks), relative to lab2/

# Web research
WEB_SEARCH_PROVIDER=ddgs
WEB_SEARCH_BACKEND=bing,duckduckgo,yandex
FIXTURE_BASE_URL=http://127.0.0.1:8765

# Elasticsearch (lab 1 MCP server), separate index for lab 2
ES_URL=http://localhost:9200
ES_INDEX=itmo_lab3_excerpts

# Default limits (any Limits field as LIMIT_<NAME>); task specs and --set override them
# LIMIT_MAX_TOTAL_TOKENS=600000
# LIMIT_MAX_MODEL_CALLS=150
# LIMIT_WORKING_CONTEXT_TOKENS=16000
# LIMIT_RESPONSE_RESERVE_TOKENS=2048
# LIMIT_MAX_SEARCH_CALLS=12
# LIMIT_MAX_HTTP_REQUESTS=80

# lab 3
ES_PREFIX=itmo_lab3
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_CACHE_DIR=.cache/fastembed
