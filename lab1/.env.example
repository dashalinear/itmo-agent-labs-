# Copy to .env and fill in. .env is git-ignored: never commit real tokens.

# LLM: OpenAI-compatible endpoint (ITMO network only)
LLM_BASE_URL=http://10.32.2.11:35000/v1
LLM_API_KEY=<your personal token>
LLM_MODEL=qwen3.8-27b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# auto = server default; true/false sends chat_template_kwargs.enable_thinking (Qwen3 on vLLM)
LLM_ENABLE_THINKING=auto

# Workspace (relative to the project root)
WORKSPACE_DIR=workspace

# Agent limits
AGENT_RECURSION_LIMIT=100
AGENT_MODEL_CALLS_PER_TURN=25
TOOL_TIMEOUT_S=30
TURN_TIMEOUT_S=600
MAX_TOOL_OUTPUT_CHARS=12000

# web_fetch
WEB_TIMEOUT_S=10
WEB_MAX_BYTES=500000
WEB_MAX_REDIRECTS=5

# Elasticsearch (reached only through the MCP server mcp_es.server)
ES_URL=http://localhost:9200
ES_INDEX=itmo_lab1_excerpts
ES_TIMEOUT_S=10
# ES_API_KEY=   # only if your cluster has security enabled
